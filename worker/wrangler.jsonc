{
  // 아지트 위스키 바 — Cloudflare 배포 설정
  "name": "ajit",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "BAR", "class_name": "BarRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BarRoom"] }],
  "observability": { "enabled": true }
}
